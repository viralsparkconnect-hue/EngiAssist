{
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/engisun",
      "destination": "/engisun.html"
    },
    {
      "source": "/Engisun",
      "destination": "/engisun.html"
    },
    {
      "source": "/EngiSun",
      "destination": "/engisun.html"
    },
    {
      "source": "/engisun/",
      "destination": "/engisun.html"
    },
    {
      "source": "/Engisun/",
      "destination": "/engisun.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}